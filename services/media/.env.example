# Copy to .env for local dev (never commit .env).

PORT=8092

# Mongo (local dev points at the mongo-media container in ../../docker-compose.yml)
MONGO_URI=mongodb://localhost:27017/dannest_media

# Must match Core's JWT_SECRET exactly — this service verifies tokens Core issues.
JWT_SECRET=change-me

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Object storage (Cloudflare R2) — same bucket Core used before the split.
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
