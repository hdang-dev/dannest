# Copy to .env for local dev (never commit .env).

PORT=8092

# Mongo (local dev points at the mongo-marketplace container in ../../docker-compose.yml)
MONGO_URI=mongodb://localhost:27017/dannest_marketplace

# Must match Core's JWT_SECRET exactly — this service verifies tokens Core issues.
JWT_SECRET=dev-only-insecure-jwt-secret-change-me-please-0123456789abcdef

CORS_ALLOWED_ORIGINS=http://localhost:3000

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Stripe (test mode). Blank is fine — the app still boots, only payment endpoints fail
# until these are set. Get them from dashboard.stripe.com (Test mode ON, top right):
#   secret-key / publishable-key : Developers > API keys
#   webhook-secret                : `stripe listen --forward-to localhost:8092/api/v1/marketplace/stripe/webhook`
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_REFRESH_URL=http://localhost:3000/settings/payouts
STRIPE_CONNECT_RETURN_URL=http://localhost:3000/settings/payouts?connected=1
