# Copy this file to `terraform.tfvars` and fill in real values.
# terraform.tfvars is gitignored — NEVER commit real secrets.

render_api_key  = "rnd_xxxxxxxxxxxxxxxxxxxx"
render_owner_id = "tea-xxxxxxxxxxxxxxxxxxxx"

db_url      = "jdbc:postgresql://YOUR-NEON-HOST/neondb?sslmode=require"
db_user     = "neondb_owner"
db_password = "npg_xxxxxxxxxxxxxx"

# ---- Notification service's own database (separate Neon instance) ----
notification_db_url      = "jdbc:postgresql://YOUR-OTHER-NEON-HOST/neondb?sslmode=require"
notification_db_user     = "neondb_owner"
notification_db_password = "npg_xxxxxxxxxxxxxx"

# Generate with: openssl rand -hex 48
jwt_secret = "your-long-random-secret"

# ---- Cloudflare R2 (media storage) ----
# Same values as services/core/src/main/resources/application-local.yml.
r2_account_id      = "your32charhexaccountid"
r2_access_key      = "your_access_key_id"
r2_secret_key      = "your_secret_access_key"
r2_bucket          = "dannest-media"
r2_public_base_url = "https://pub-xxxx.r2.dev"

# ---- RabbitMQ (CloudAMQP free tier) ----
# From the CloudAMQP dashboard's "AMQP details" panel — use the DNS load-balanced
# Cluster host (not a specific node), and the TLS port (5671).
rabbitmq_host      = "your-instance.rmq.cloudamqp.com"
rabbitmq_username  = "your-vhost-name"
rabbitmq_password  = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
rabbitmq_vhost     = "your-vhost-name"

# ---- Redis (Upstash free tier) ----
# From the Upstash console's database details panel ("Endpoint" and "Password").
# Backs Core's refresh tokens only — no caching yet.
redis_host     = "your-instance.upstash.io"
redis_port     = "6379"
redis_password = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ---- MongoDB Atlas free tier (services/marketplace's own database) ----
mongo_marketplace_uri = "mongodb+srv://your-user:your-password@your-cluster.mongodb.net/dannest_marketplace?retryWrites=true&w=majority&appName=Cluster0"

# ---- Stripe (test mode) ----
# dashboard.stripe.com, "Test mode" ON (top right) -> Developers > API keys / Webhooks.
stripe_secret_key      = "sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
stripe_publishable_key = "pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
stripe_webhook_secret  = "whsec_xxxxxxxxxxxxxxxxxxxxxxxx"
